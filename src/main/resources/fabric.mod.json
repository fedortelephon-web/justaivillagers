{
  "schemaVersion": 1,
  "id": "justaivillagers",
  "version": "${version}",
  "name": "Just AI Villagers",
  "description": "Villagers that actually talk: per-villager personalities, memories, event reactions and evening conversations, generated by a local language model (Ollama or any OpenAI-compatible server).",
  "authors": [
    "justaivillagers"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/just-ai-villagers",
    "sources": "https://github.com/fedortelephon-web/justaivillagers",
    "issues": "https://github.com/fedortelephon-web/justaivillagers/issues"
  },
  "license": "MIT",
  "icon": "assets/justaivillagers/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.justaivillagers.fabric.JustAiVillagersClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-api": ">=${fabric_api}",
    "minecraft": "~1.21.1",
    "java": ">=21"
  }
}
